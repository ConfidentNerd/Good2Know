# Copy to server/.env and fill in. None of this is needed for local dev:
# without it the server talks to a local mongod and trusts localhost origins.

# MongoDB connection string. Required in production.
# Atlas format: mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_URI=

# Database name inside that cluster. Defaults to "good2know".
MONGODB_DB=good2know

# Comma-separated list of origins allowed to make non-GET requests.
# On Render this is optional: RENDER_EXTERNAL_URL is trusted automatically.
# Set it when you point a custom domain at the service.
ALLOWED_ORIGINS=

# Port to listen on. Render injects this automatically; defaults to 32432.
PORT=32432
